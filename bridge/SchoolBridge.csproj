<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants Condition="'$(DPUruNetPath)' != ''">$(DefineConstants);DIGITALPERSONA_SDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Fleck" Version="1.2.0" /></ItemGroup>
  <ItemGroup Condition="'$(DPUruNetPath)' != ''"><Reference Include="DPUruNet"><HintPath>$(DPUruNetPath)</HintPath><Private>true</Private></Reference></ItemGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs"/><None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
